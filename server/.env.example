PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Path to the Firebase service-account JSON downloaded from:
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
# Place it at server/credentials/service-account.json (keep it out of Git).
FIREBASE_SERVICE_ACCOUNT_PATH=credentials/service-account.json

# Optional: a different service-account JSON file for Sheets.
# Leave unset to use FIREBASE_SERVICE_ACCOUNT_PATH.
# GOOGLE_SERVICE_ACCOUNT_PATH=credentials/sheets-service-account.json

# Spreadsheet ID: the long value between /d/ and /edit in its URL.
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_the_spreadsheet_id
