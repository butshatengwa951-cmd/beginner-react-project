PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin credentials for verifying ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-admin-service-account@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_the_real_private_key\n-----END PRIVATE KEY-----\n"

# Google Sheets API service-account credentials.
# These may be the same service account if it has all required permissions.
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-service-account@your-google-cloud-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_the_real_private_key\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=replace_with_the_spreadsheet_id
